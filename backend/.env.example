# Aerotrace MAA Backend Environment Variables

# Server
SERVER_PORT=8080

# Primary Operational Database (PostgreSQL 17)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aerotrace_india
SPRING_DATASOURCE_USERNAME=aerotrace_app
SPRING_DATASOURCE_PASSWORD=aerotrace_secure_password_2026

# Telemetry Database (MongoDB 7.0)
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/aerotrace_telemetry
MONGODB_ENABLED=true

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=aerotrace_neo4j_2026
NEO4J_ENABLED=true

# Secondary Database Demonstration (MySQL 8.0)
MYSQL_URL=jdbc:mysql://localhost:3306/aerotrace_secondary?useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=aerotrace_sync
MYSQL_PASSWORD=aerotrace_mysql_password_2026
MYSQL_ENABLED=true

# Security & JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
